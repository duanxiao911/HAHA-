ARG PYTHON_BASE_IMAGE=mcr.microsoft.com/azurelinux/base/python:3.12@sha256:b006d366ab67c2170e5ed5b7d34500e0291373df7faedc1d1ca2472944f6c7b2
FROM ${PYTHON_BASE_IMAGE}
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HAHA_CORE_DB=/var/lib/haha/haha_core.db

WORKDIR /app

RUN ln -sf /usr/bin/python3 /usr/local/bin/python

COPY pyproject.toml README.md ./
COPY src ./src
COPY data/heritage_facts.json ./data/heritage_facts.json
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

RUN python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" .
RUN mkdir -p /var/lib/haha && chown -R 65532:65532 /app /var/lib/haha

USER 65532:65532
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"

CMD ["python", "-m", "uvicorn", "haha_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
