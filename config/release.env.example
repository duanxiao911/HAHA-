# Immutable images. Replace every digest with one produced and scanned by the release pipeline.
POSTGRES_IMAGE=postgres:17-alpine@sha256:replace-with-64-hex-digest
REDIS_IMAGE=redis:8-alpine@sha256:replace-with-64-hex-digest
HAHA_API_IMAGE=ghcr.io/example/haha-api@sha256:replace-with-64-hex-digest
HAHA_WEB_IMAGE=ghcr.io/example/haha-web@sha256:replace-with-64-hex-digest

# External URLs. TLS terminates at the staging ingress; containers remain loopback-bound.
HAHA_PUBLIC_API_URL=https://api.staging.example.com
HAHA_PUBLIC_WEB_ORIGIN=https://staging.example.com
HAHA_ALLOWED_ORIGINS=https://staging.example.com
HAHA_API_BIND=127.0.0.1:18000
HAHA_WEB_BIND=127.0.0.1:13000

# Runtime secrets. Never commit populated values.
POSTGRES_PASSWORD=replace-with-a-long-random-password
HAHA_JWT_SECRET=replace-with-at-least-32-random-characters
HAHA_JWT_ISSUER=haha-auth
HAHA_JWT_AUDIENCE=haha-api

# Release identity and accountable roles.
HAHA_RELEASE_ID=2026-10-09.c5.1
HAHA_RELEASE_OWNER=replace-with-release-owner
HAHA_ROLLBACK_OWNER=replace-with-rollback-owner
HAHA_SECURITY_OWNER=replace-with-security-owner
HAHA_DATA_OWNER=replace-with-data-owner
HAHA_ONCALL_CONTACT=replace-with-oncall-contact
