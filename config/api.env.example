# HAHA Creator API runtime settings
HAHA_CORE_DB=data/haha_core.db
HAHA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://haha:change-me@127.0.0.1:5432/haha
REDIS_URL=redis://127.0.0.1:6379/0
HAHA_ENVIRONMENT=production
HAHA_AUTH_MODE=jwt
HAHA_ALLOW_DEV_AUTH=false
HAHA_JWT_SECRET=replace-with-at-least-32-random-characters
HAHA_JWT_ISSUER=haha-auth
HAHA_JWT_AUDIENCE=haha-api

# Model credentials remain server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_API_TIMEOUT=300

# Local header-based authentication is deliberately fail-closed. To opt in,
# set all three values together: HAHA_ENVIRONMENT=development,
# HAHA_AUTH_MODE=dev, and HAHA_ALLOW_DEV_AUTH=true. Never use this on a
# shared or remotely reachable host.
